# Copy this file to .env and fill in real values locally.
# NEVER commit .env. NEVER put real keys in this file.

# Sent to the app (EXPO_PUBLIC_ prefix) — safe to be public; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER add the EXPO_PUBLIC_ prefix to these.
# Real values live in Supabase secrets.
ANTHROPIC_API_KEY=
USDA_FDC_API_KEY=
